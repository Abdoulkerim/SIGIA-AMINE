# SIGIA-AMINE production web application
# Configure these in Vercel (Production) and/or your hosting provider.
# Do NOT commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY

# Server-only: required for administrator-managed user creation.
# Use the project's `service_role` key or secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY

# Optional public URL used by operational tooling/documentation.
NEXT_PUBLIC_APP_URL=https://app.example.com
