# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLLER_ICI_LA_CLE_ANON_LOCALE

# Server-only secrets. Never expose these to the browser.
# Local: values from `npx supabase status -o env`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=COLLER_ICI_LA_CLE_SECRET_LOCALE

# Only for the one-time local bootstrap script.
ADMIN_EMAIL=admin@al-amine.local
ADMIN_PASSWORD=CHANGE_ME_ONLY_FOR_LOCAL
ADMIN_FIRST_NAME=Administrateur
ADMIN_LAST_NAME=SIGIA
ADMIN_ROLE_CODE=founder
SCHOOL_CODE=AL-AMINE
